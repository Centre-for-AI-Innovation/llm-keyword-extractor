# LLM Keyword Generator - Environment Configuration
# Copy this file to .env and fill in the values for the model(s) you plan to use.
# Only the variables for your selected model are required.

# -----------------------------------------------------------------------------
# Defaults
# -----------------------------------------------------------------------------

# Which registered model to use when --model / model= is not specified.
DEFAULT_LLM_MODEL=gpt-4o-mini

# Default number of keywords to extract when not specified.
DEFAULT_KEYWORD_COUNT=10

# Default theme guiding keyword selection when not specified.
DEFAULT_THEME=AI and Robotics within healthcare

# Request behavior
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_KEY=your_azure_api_key_here
ENDPOINT=https://your-resource.openai.azure.com/
DEPLOYMENT_NAME=your_deployment_name_here

